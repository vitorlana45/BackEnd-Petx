# Variáveis de ambiente do BackEnd-Petx
# Copie para .env (NÃO versionado) ou exporte no ambiente antes de subir a app.

# ---- Banco de dados ----
# dev tem defaults locais (localhost/root); prod é obrigatório.
DATABASE_URL=jdbc:postgresql://localhost:5432/ong_db
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# ---- E-mail (Gmail SMTP) ----
# OBRIGATÓRIO para recuperação de senha funcionar. Use uma App Password do Google.
EMAIL_USERNAME=
EMAIL_PASSWORD=

# URL do front para o link de redefinição de senha
FRONTEND_URL=http://localhost:3000/reset-password/

# ---- MinIO (armazenamento de imagens) ----
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=12345678
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=ong
